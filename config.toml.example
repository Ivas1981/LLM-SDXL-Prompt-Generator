# LM Studio connection settings.
# Copy this file to config.toml and fill in your values.
# config.toml is gitignored so secrets stay local.

[lm_studio]
# Full v1 native endpoint URL. Takes precedence over host/port.
# Example: "http://192.168.1.10:1234/api/v1"
# url = "http://localhost:1234/api/v1"

# Alternative: build the URL from host + port.
# Used only when `url` is not set.
# host = "localhost"
# port = 1234
# use_ssl = false

# OpenAI-compatible base (used for /v1/embeddings).
# openai_url = "http://localhost:1234/v1"

# Bearer token for LM Studio's auth feature (Developer → Server Settings).
# Leave empty to be prompted interactively on a 401 response.
# api_token = ""

# Debug logging. Write requests, responses, and errors to debug.log.
# debug = false

# Timeout for model operations (load/unload/list) in seconds.
# models_timeout = 180

# Timeout for chat requests in seconds.
# chat_timeout = 600

[generation]
# Cosine similarity threshold above which a new scene is rejected as a duplicate.
# uniqueness_threshold = 0.85

# Enable NSFW mode. When true, step4_state includes nudity field.
# nsfw = false

# Context length passed to POST /api/v1/models/load.
# lm_context_length = 8192

# Multiplier for max attempts: max_attempts = target_count * this.
# max_attempts_multiplier = 10

# Baseline negative prompt tags (comma-separated).
# negative_base_tags = "deformed, bad anatomy, ..."

# Output JSON file path.
# output_json = "sdxl_styles.json"

# Placeholder for appearance description in the positive prompt.
# context_token = "{prompt}"

# Override path to LM Studio server logs (used by lm_logs.py).
# lm_studio_log_root = ""

# Override path to config.toml.
# promptgen_config = ""